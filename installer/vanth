#!/usr/bin/env bash
# vanth - instalador del modulo Auto Totem (libReverseSigma.so) para Termux.
#
# Uso:
#   vanth install   --dest RUTA [--tag vX.Y.Z]   descarga e instala la version indicada (o la ultima)
#   vanth status    --dest RUTA                  muestra version instalada y si coincide con el release
#   vanth uninstall --dest RUTA                  restaura la copia de respaldo
#
# Variables de entorno:
#   VANTH_REPO   propietario/repositorio en GitHub (obligatorio)
#   VANTH_DEST   ruta destino por defecto (si no se usa --dest)
#   VANTH_ARCH   fuerza la arquitectura (solo para pruebas)
#   VANTH_API    base de la API (por defecto https://api.github.com)
#   VANTH_BASE   base de descargas (por defecto https://github.com)
set -euo pipefail

VERSION="1.0.0"
VANTH_API="${VANTH_API:-https://api.github.com}"
VANTH_BASE="${VANTH_BASE:-https://github.com}"
LIB_NAME="libReverseSigma.so"

info()  { printf '\033[1;34m[vanth]\033[0m %s\n' "$*"; }
ok()    { printf '\033[1;32m[ ok ]\033[0m %s\n' "$*"; }
warn()  { printf '\033[1;33m[warn]\033[0m %s\n' "$*" >&2; }
fail()  { printf '\033[1;31m[fail]\033[0m %s\n' "$*" >&2; exit 1; }

usage() {
    sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
    exit "${1:-0}"
}

# ---------- validaciones del entorno ----------
check_termux() {
    if [[ -z "${PREFIX:-}" || "$PREFIX" != *com.termux* ]]; then
        fail "Este instalador esta pensado para Termux (no se detecto \$PREFIX de Termux)."
    fi
    ok "Entorno Termux detectado"
}

check_tools() {
    local t missing=()
    for t in curl sha256sum; do
        command -v "$t" >/dev/null 2>&1 || missing+=("$t")
    done
    if ((${#missing[@]})); then
        fail "Faltan herramientas: ${missing[*]}. Instala con: pkg install curl coreutils"
    fi
    ok "Herramientas disponibles (curl, sha256sum)"
}

detect_abi() {
    local m="${VANTH_ARCH:-$(uname -m)}"
    case "$m" in
        aarch64|arm64|arm64-v8a)           echo "arm64-v8a" ;;
        armv7l|armv8l|arm|armeabi-v7a)     echo "armeabi-v7a" ;;
        x86_64)
            fail "x86_64 no esta compilado en este release (solo arm64-v8a y armeabi-v7a)." ;;
        *)
            fail "Arquitectura no soportada: $m" ;;
    esac
}

require_repo() {
    if [[ -z "${VANTH_REPO:-}" || "$VANTH_REPO" == "OWNER/REPO" || "$VANTH_REPO" != */* ]]; then
        fail "Define VANTH_REPO=propietario/repositorio (ejemplo: export VANTH_REPO=usuario/vanth)."
    fi
}

resolve_dest() {
    local dest="${1:-${VANTH_DEST:-}}"
    [[ -n "$dest" ]] || fail "Falta la ruta destino. Usa --dest RUTA o VANTH_DEST."
    [[ "$dest" == /* ]] || fail "La ruta destino debe ser absoluta: $dest"
    DEST_FILE="$dest"
    DEST_DIR="$(dirname "$dest")"
    BAK_FILE="$dest.vanth.bak"
}

check_writable() {
    [[ -d "$DEST_DIR" ]] || fail "La carpeta destino no existe: $DEST_DIR"
    local probe="$DEST_DIR/.vanth_write_test.$$"
    if ! ( : > "$probe" ) 2>/dev/null; then
        fail "Sin permisos de escritura en $DEST_DIR. Revisa que Vanth tenga acceso a esa carpeta."
    fi
    rm -f "$probe"
    ok "Carpeta destino escribible"
}

# ---------- red / release ----------
latest_tag() {
    local body tag
    body="$(curl -fsSL --retry 2 "$VANTH_API/repos/$VANTH_REPO/releases/latest")" \
        || fail "No se pudo consultar el ultimo release de $VANTH_REPO."
    tag="$(printf '%s\n' "$body" | sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p' | head -n1)"
    [[ -n "$tag" ]] || fail "La respuesta de GitHub no contiene tag_name (repositorio sin releases?)."
    printf '%s' "$tag"
}

download() { # url destino
    curl -fsSL --retry 2 -o "$2" "$1" || fail "Fallo la descarga: $1"
}

# ---------- comandos ----------
cmd_install() {
    local tag="" dest_arg=""
    while (($#)); do
        case "$1" in
            --dest) dest_arg="${2:-}"; shift 2 ;;
            --tag)  tag="${2:-}"; shift 2 ;;
            *) fail "Opcion desconocida para install: $1" ;;
        esac
    done
    check_termux; check_tools; require_repo
    resolve_dest "$dest_arg"
    check_writable
    local abi; abi="$(detect_abi)"
    ok "Arquitectura: $abi"

    [[ -n "$tag" ]] || { info "Consultando ultimo release..."; tag="$(latest_tag)"; }
    ok "Release: $tag"

    TMP_DIR="$(mktemp -d "${TMPDIR:-/data/data/com.termux/files/usr/tmp}/vanth.XXXXXX")"
    local tmp="$TMP_DIR"
    local asset="libReverseSigma-$abi.so"
    local base="$VANTH_BASE/$VANTH_REPO/releases/download/$tag"

    info "Descargando $asset..."
    download "$base/$asset" "$tmp/$asset"
    download "$base/$asset.sha256" "$tmp/$asset.sha256"

    info "Verificando SHA-256..."
    ( cd "$tmp" && sha256sum -c "$asset.sha256" >/dev/null 2>&1 ) \
        || fail "La verificacion SHA-256 fallo. El archivo descargado no es confiable; no se instalo nada."
    ok "SHA-256 correcto"

    if [[ -f "$DEST_FILE" && ! -f "$BAK_FILE" ]]; then
        cp -p "$DEST_FILE" "$BAK_FILE"
        ok "Copia de respaldo: $BAK_FILE"
    fi

    # Instalacion atomica: copiar a un temporal en la misma carpeta y renombrar.
    cp "$tmp/$asset" "$DEST_DIR/.$LIB_NAME.new"
    chmod 644 "$DEST_DIR/.$LIB_NAME.new"
    mv -f "$DEST_DIR/.$LIB_NAME.new" "$DEST_FILE"
    printf '%s %s\n' "$tag" "$abi" > "$DEST_DIR/.$LIB_NAME.vanth"
    ok "Instalado en $DEST_FILE ($tag, $abi)"
    info "Reinicia Minecraft para cargar el modulo."
}

cmd_status() {
    local dest_arg=""
    while (($#)); do
        case "$1" in
            --dest) dest_arg="${2:-}"; shift 2 ;;
            *) fail "Opcion desconocida para status: $1" ;;
        esac
    done
    check_termux; require_repo
    resolve_dest "$dest_arg"
    if [[ -f "$DEST_FILE" ]]; then
        ok "Instalado: $DEST_FILE ($(wc -c < "$DEST_FILE") bytes)"
        if [[ -f "$DEST_DIR/.$LIB_NAME.vanth" ]]; then
            info "Version instalada: $(cat "$DEST_DIR/.$LIB_NAME.vanth")"
        fi
    else
        warn "No instalado en $DEST_FILE"
    fi
    local latest
    latest="$(latest_tag 2>/dev/null)" && info "Ultimo release en GitHub: $latest" || warn "No se pudo consultar GitHub."
}

cmd_uninstall() {
    local dest_arg=""
    while (($#)); do
        case "$1" in
            --dest) dest_arg="${2:-}"; shift 2 ;;
            *) fail "Opcion desconocida para uninstall: $1" ;;
        esac
    done
    check_termux
    resolve_dest "$dest_arg"
    check_writable
    if [[ -f "$BAK_FILE" ]]; then
        mv -f "$BAK_FILE" "$DEST_FILE"
        rm -f "$DEST_DIR/.$LIB_NAME.vanth"
        ok "Restaurada la copia original desde $BAK_FILE"
    elif [[ -f "$DEST_FILE" ]]; then
        rm -f "$DEST_FILE" "$DEST_DIR/.$LIB_NAME.vanth"
        ok "Modulo eliminado (no habia copia de respaldo)"
    else
        warn "Nada que desinstalar en $DEST_FILE"
    fi
}

TMP_DIR=""
cleanup() { [[ -n "${TMP_DIR:-}" && -d "$TMP_DIR" ]] && rm -rf "$TMP_DIR"; return 0; }
trap cleanup EXIT

main() {
    local cmd="${1:-}"; shift || true
    case "$cmd" in
        install)   cmd_install "$@" ;;
        status)    cmd_status "$@" ;;
        uninstall) cmd_uninstall "$@" ;;
        -h|--help|help|"") usage 0 ;;
        --version) echo "vanth $VERSION" ;;
        *) warn "Comando desconocido: $cmd"; usage 1 ;;
    esac
}

main "$@"
